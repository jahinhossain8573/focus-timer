model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String?
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model Session {
  id        Int      @id @default(autoincrement())
  title     String
  time      Int
  createdAt DateTime @default(now())
}
